{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import", "unicorn"],
  "env": {
    "node": true
  },
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "restriction": "off",
    "style": "off",
    "nursery": "off"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": "off",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "warn",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports"
      }
    ],
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css", "**/ts-loader.mjs"] }],
    "no-underscore-dangle": [
      "warn",
      { "allow": ["_raw", "__CFBundleIdentifier", "__mateThemeSwap"] }
    ],
    "react/react-in-jsx-scope": "off",
    "react/self-closing-comp": "warn",
    "react/jsx-no-useless-fragment": "warn",
    "react/no-unknown-property": "error",
    "react/jsx-key": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["packages/mate-core/src/cli/commands/studio/views/**/*.tsx"],
      "rules": {
        "react/no-unknown-property": "off",
        "react/jsx-key": "off"
      }
    },
    {
      "files": [
        "packages/mate-core/src/lib/friction/view/model.ts",
        "packages/mate-core/src/lib/friction/view/select.ts",
        "packages/mate-core/src/runtime/friction-retention.ts",
        "packages/mate-core/src/runtime/friction-vocabulary.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**", "!./model", "!**/friction-retention", "!**/friction-vocabulary"],
                "allowTypeImports": true,
                "message": "Studio's browser client imports this module: import only the other browser-safe friction modules, or types."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    "node_modules",
    "packages/mate-core/claude-capability-plugins/companion-mentions/.claude-plugin/types",
    "dist",
    "_artifacts",
    "apps/mate-cli/src/templates",
    "*.test.{ts,tsx}",
    "*.spec.{ts,tsx}",
    "*.generated.{ts,js}"
  ]
}
