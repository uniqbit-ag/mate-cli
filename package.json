{
  "name": "mate-workspace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "appliance:local": "bun apps/mate-container/scripts/local-up.ts up",
    "appliance:local:down": "bun apps/mate-container/scripts/local-up.ts down",
    "appliance:local:reset": "bun apps/mate-container/scripts/local-up.ts reset",
    "appliance:local:logs": "bun apps/mate-container/scripts/local-up.ts logs",
    "factory:local": "bun apps/mate-factory/scripts/local-up.ts up",
    "factory:local:down": "bun apps/mate-factory/scripts/local-up.ts down",
    "factory:local:reset": "bun apps/mate-factory/scripts/local-up.ts reset",
    "factory:local:logs": "bun apps/mate-factory/scripts/local-up.ts logs",
    "factory:dogfood": "bash apps/mate-factory/scripts/dogfood.sh up",
    "factory:dogfood:down": "bash apps/mate-factory/scripts/dogfood.sh down",
    "factory:dogfood:pull": "bash apps/mate-factory/scripts/dogfood.sh pull",
    "brand:generate": "bun scripts/brand/generate.ts",
    "brand:check": "bun scripts/brand/generate.ts --check",
    "vendor:openspec": "bun scripts/vendor-openspec/vendor.ts",
    "docs": "bun run --filter @uniqbit/mate-docs dev",
    "docs:build": "bun run --filter @uniqbit/mate-docs build",
    "docs:check": "bun run --filter @uniqbit/mate-docs check",
    "prepare": "bun run --filter @uniqbit/mate prepare",
    "release": "bun run --cwd ./apps/mate-cli release",
    "release:canary": "bun run --cwd ./apps/mate-cli release:canary",
    "release:dry-run": "bun run --cwd ./apps/mate-cli release:dry-run",
    "test": "bun run --filter @uniqbit/mate --filter @uniqbit/mate-core --filter @uniqbit/mate-container --filter @uniqbit/mate-vscode test",
    "test:unit": "bun run --filter @uniqbit/mate --filter @uniqbit/mate-core --filter @uniqbit/mate-container --filter @uniqbit/mate-vscode test:unit",
    "test:integration": "bun run --filter @uniqbit/mate --filter @uniqbit/mate-core --filter @uniqbit/mate-container test:integration",
    "test:ci": "bun run --filter @uniqbit/mate test:ci",
    "test:coverage": "bun run --filter @uniqbit/mate test:coverage",
    "typecheck": "bun run --filter @uniqbit/mate --filter @uniqbit/mate-vscode typecheck",
    "image-locks:check": "bun scripts/image-locks/cli.ts check",
    "image-locks:refresh": "bun scripts/image-locks/cli.ts refresh",
    "test:image-locks": "bun test/run-isolated.ts --suite=unit scripts/image-locks",
    "lint": "oxlint apps packages scripts/image-locks --no-error-on-unmatched-pattern",
    "lint:fix": "bunx oxlint apps packages scripts/image-locks --fix --no-error-on-unmatched-pattern",
    "format": "oxfmt apps packages scripts/image-locks \"!**/*.generated.*\" --no-error-on-unmatched-pattern",
    "format:check": "oxfmt apps packages scripts/image-locks \"!**/*.generated.*\" --check --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.4"
}
