{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "importOrder": {
    "enabled": true
  },
  "ignorePatterns": [
    "node_modules",
    "packages/mate-plugin-companion-mentions/claude-plugin/.claude-plugin/types",
    "dist",
    "_artifacts",
    "apps/mate-cli/src/templates",
    "**/*.generated.*",
    "packages/mate-core/src/templates/mate-skills/*/*/references/openspec-*.md"
  ]
}
