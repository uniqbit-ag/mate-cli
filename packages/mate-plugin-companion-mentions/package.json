{
  "name": "@uniqbit/mate-plugin-companion-mentions",
  "version": "0.18.5",
  "description": "Mate plugin: find and attach Companion Repository files from Claude Code's @ menu as @mate:<path>.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniqbit-ag/mate-cli.git",
    "directory": "packages/mate-plugin-companion-mentions"
  },
  "files": [
    "src/",
    "claude-plugin/",
    "README.md",
    "!**/*.test.ts",
    "!claude-plugin/tests/",
    "!claude-plugin/tsconfig.json",
    "!claude-plugin/.claude-plugin/types/"
  ],
  "type": "module",
  "exports": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "CI=1 bun ../../test/run-isolated.ts ./src ./test ./claude-plugin/tests/companion.test.ts",
    "test:hooks": "claude plugin validate --strict claude-plugin && claude plugin test claude-plugin",
    "lint": "oxlint src/ test/ claude-plugin/hooks/",
    "lint:fix": "oxlint src/ test/ claude-plugin/hooks/ --fix",
    "format": "oxfmt src/ test/ claude-plugin/",
    "format:check": "oxfmt src/ test/ claude-plugin/ --check"
  },
  "devDependencies": {
    "@uniqbit/mate-core": "0.18.5"
  },
  "engines": {
    "node": ">=24"
  },
  "mate": {
    "pluginApiVersion": 1
  }
}
