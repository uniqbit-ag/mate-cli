<!-- MATE:COMPANION:END -->
"
,
  "claudeSettingsLocal": {
    "autoMemoryEnabled": false,
    "hooks": {
      "PostToolUse": [
        {
          "hooks": [
            {
              "command": "sh "<root>/companion/.claude/hooks/react-doctor.sh"",
              "timeout": 5,
              "type": "command",
            },
          ],
          "matcher": "Write|Edit|MultiEdit|NotebookEdit|ApplyPatch",
        },
      ],
      "PreToolUse": [
        {
          "hooks": [
            {
              "args": [
                "hook-pre-tool-use",
              ],
              "command": "<root>/bin/tokensave",
              "type": "command",
            },
          ],
          "matcher": "Agent|Grep|Bash",
        },
        {
          "hooks": [
            {
              "command": "<root>/companion/.claude/hooks/graphify-guard.sh",
              "type": "command",
            },
          ],
          "matcher": "Bash",
        },
      ],
      "Stop": [
        {
          "hooks": [
            {
              "args": [
                "hook-stop",
              ],
              "command": "<root>/bin/tokensave",
              "type": "command",
            },
          ],
        },
        {
          "hooks": [
            {
              "command": "sh "<root>/companion/.claude/hooks/react-doctor.sh"",
              "timeout": 45,
              "type": "command",
            },
          ],
        },
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "args": [
                "hook-prompt-submit",
              ],
              "command": "<root>/bin/tokensave",
              "type": "command",
            },
          ],
        },
      ],
    },
    "permissions": {
      "allow": [
        "Bash(<wrapper-bin>/graphify:*)",
        "Bash(<wrapper-bin>/openspec:*)",
        "Bash(graphify:*)",
        "Bash(mate cap graphify:*)",
        "Bash(mate cap graphify:*)",
        "Bash(mate:*)",
        "Bash(npx react-doctor:*)",
        "Bash(npx react-doctor@latest *)",
        "Bash(openspec:*)",
        "Edit(<root>/companion/**)",
        "Read(<root>/companion/**)",
        "Skill(context-mode:context-mode)",
        "Skill(graphify)",
        "Skill(mate-artifact-finish)",
        "Skill(mate-openspec-backfill)",
        "Skill(openspec-apply-change)",
        "Skill(openspec-archive-change)",
        "Skill(openspec-explore)",
        "Skill(openspec-propose)",
        "Skill(react-doctor)",
        "mcp__plugin_context-mode_context-mode__*",
        "mcp__tokensave__*",
      ],
    },
  },
  "claudeSkills": {
    "graphify/SKILL.md": 
"---
description: builds graphify-out artifacts
---
Write chunks to $GRAPHIFY_OUT and read $GRAPHIFY_OUT later.
"
,
    "graphify/references/github-and-merge.md": 
"Merge graphs into graphify-out of each clone.
"
,
    "graphify/references/usage.md": 
