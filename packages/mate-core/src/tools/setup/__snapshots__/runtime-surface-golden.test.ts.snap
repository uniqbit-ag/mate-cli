        ],
      },
      {
        "at": [
          "env",
        ],
        "entries": {},
        "kind": "map",
        "stripPrefix": "MATE_",
      },
      {
        "at": [
          "permissions",
          "allow",
        ],
        "kind": "list",
        "values": [
          "Bash(mate:*)",
          "Read(<root>/companion/**)",
          "Edit(<root>/companion/**)",
          "Skill(graphify)",
          "Bash(graphify:*)",
          "Bash(mate cap graphify:*)",
          "Bash(<wrapper-bin>/graphify:*)",
        ],
      },
      {
        "at": [
          "permissions",
          "deny",
        ],
        "kind": "list",
        "values": [
          "EnterPlanMode",
          "DesignSync",
          "Read(**/.env)",
          "Edit(**/.env)",
          "Read(**/.env.local)",
          "Edit(**/.env.local)",
          "Read(**/.env.development)",
          "Edit(**/.env.development)",
          "Read(**/.env.production)",
          "Edit(**/.env.production)",
          "Read(**/.env.test)",
          "Edit(**/.env.test)",
          "Read(**/.env.*.local)",
          "Edit(**/.env.*.local)",
          "Read(**/*.pem)",
          "Edit(**/*.pem)",
          "Read(**/*.key)",
          "Edit(**/*.key)",
          "Read(**/*.p12)",
          "Edit(**/*.p12)",
          "Read(**/*.pfx)",
          "Edit(**/*.pfx)",
          "Read(**/id_rsa)",
          "Edit(**/id_rsa)",
          "Read(**/id_ecdsa)",
          "Edit(**/id_ecdsa)",
          "Read(**/id_ed25519)",
          "Edit(**/id_ed25519)",
          "Read(**/.netrc)",
          "Edit(**/.netrc)",
          "Read(**/.pgpass)",
          "Edit(**/.pgpass)",
          "Read(**/.npmrc)",
          "Edit(**/.npmrc)",
        ],
      },
      {
        "at": [
          "enableArtifact",
        ],
        "kind": "value",
        "value": false,
        "yields": true,
      },
      {
        "at": [
          "attribution",
        ],
        "kind": "value",
        "value": {
          "commit": "",
          "pr": "",
          "sessionUrl": false,
        },
        "yields": true,
      },
    ],
  },
]
`;

