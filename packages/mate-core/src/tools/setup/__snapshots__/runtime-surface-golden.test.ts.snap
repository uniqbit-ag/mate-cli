                "type": "command",
              },
            ],
          },
          {
            "hooks": [
              {
                "command": "node "<runtime-claude-plugin>/hooks/session-guidance.mjs"",
                "type": "command",
              },
            ],
          },
          {
            "hooks": [
              {
                "command": "node "<runtime-claude-plugin>/hooks/session-prepare.mjs" --projected",
                "timeout": 45,
                "type": "command",
              },
            ],
          },
        ],
      },
      {
        "at": [
          "hooks",
          "SubagentStart",
        ],
        "kind": "list",
        "values": [
