        "Edit(**/*.pem)",
        "Read(**/*.key)",
        "Edit(**/*.key)",
        "Read(**/*.p12)",
        "Edit(**/*.p12)",
        "Read(**/*.pfx)",
        "Edit(**/*.pfx)",
        "Read(**/id_rsa)",
        "Edit(**/id_rsa)",
        "Read(**/id_ecdsa)",
        "Edit(**/id_ecdsa)",
        "Read(**/id_ed25519)",
        "Edit(**/id_ed25519)",
        "Read(**/.netrc)",
        "Edit(**/.netrc)",
        "Read(**/.pgpass)",
        "Edit(**/.pgpass)",
        "Read(**/.npmrc)",
        "Edit(**/.npmrc)",
      ],
    },
  },
  "claudeSkills": {
    "graphify/SKILL.md": 
"---
description: builds graphify-out artifacts
---
Write chunks to $GRAPHIFY_OUT and read $GRAPHIFY_OUT later.
"
,
    "graphify/references/github-and-merge.md": 
"Merge graphs into graphify-out of each clone.
"
,
