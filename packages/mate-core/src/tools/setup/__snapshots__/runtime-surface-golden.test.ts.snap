[
  {
    "path": ".claude/settings.local.json",
    "regions": [
      {
        "at": [
          "hooks",
          "PreToolUse",
        ],
        "kind": "list",
        "values": [
          {
            "hooks": [
              {
                "command": "node "<runtime-claude-plugin>/hooks/validate-artifact-path.mjs"",
                "type": "command",
              },
            ],
            "matcher": "Read|Grep|Write|Edit|MultiEdit|NotebookEdit|Bash",
