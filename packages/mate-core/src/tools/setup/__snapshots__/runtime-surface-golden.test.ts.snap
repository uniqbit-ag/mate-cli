exports[`working repo golden fixtures sync working repo with capabilities [tokensave, react-doctor] 1`] = `
{
  "claudeMd": 
"# Project

User notes.
"
,
  "gitExclude": 
".claude/settings.local.json
.mcp.json
.tokensave/
"
,
  "settingsLocal": {
    "enabledMcpjsonServers": [
      "tokensave",
      "mate",
    ],
    "enabledPlugins": {
      "mate-companion@mate-companion": true,
    },
    "env": {
      "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
      "MATE_ARTIFACT_PATH": "<root>/companion",
      "MATE_GIT_AUTO_MODE": "0",
      "MATE_GRAPHIFY_ENABLED": "0",
      "MATE_NAME": "mate",
      "MATE_OPENSPEC_ENABLED": "0",
      "MATE_POLICY_JSON": "{"allowedAgents":["claude"]}",
      "MATE_REACT_DOCTOR_BIN_PATH": "<reactDoctorBin>",
      "MATE_REACT_DOCTOR_ENABLED": "1",
      "MATE_REPO_ID": "working",
      "MATE_REPO_PATH": "<root>/working",
      "MATE_VERSION": "<version>",
      "MATE_WRAPPER_BIN_PATH": "<wrapperBin>",
    },
    "extraKnownMarketplaces": {
      "mate-companion": {
        "source": {
          "path": "<root>/companion",
          "source": "directory",
        },
      },
    },
    "hooks": {
      "PreToolUse": [
        {
          "hooks": [
            {
              "command": "user-hook.sh",
              "type": "command",
            },
          ],
          "matcher": "Bash",
        },
      ],
    },
    "permissions": {
      "additionalDirectories": [
        "<root>/working/keep",
        "<root>/companion",
      ],
      "allow": [
        "User(entry)",
      ],
    },
  },
}
`;

