  "claudeMd": 
"<!-- MATE:COMPANION:START -->

You are operating in a Mate-managed session.

Canonical companion policy is injected through \`<companion-policy framework="mate" priority="mandatory">\`.
This block is kept for Claude/AGENTS.md compatibility and must not restate that policy.

## Claude Notes

- Use absolute paths when a tool needs a file path. Do not create literal \`$MATE_REPO_PATH\` or \`$MATE_ARTIFACT_PATH\` directories.
- When reporting information to me, be extremely concise and sacrifice grammar for the sake of concision. Apply this same preference to JSDoc.
- Code comments: JSDoc format only (\`/** ... */\`), never \`//\`. Sparse — only non-obvious invariants or constraints, never restated artifact rationale.
- Claude Code receives \`$MATE_ARTIFACT_PATH\` via \`--add-dir\`; if \`@\` autocomplete does not show companion artifacts, reference them by absolute path.
- The root \`CLAUDE.md\` in the companion repo is intentional and loaded by Mate. Do not create another project-level \`CLAUDE.md\` in the working repo unless the user explicitly asks for one.
- Never add a \`Co-Authored-By: <model>\` trailer or model-attribution footer to commit messages.
- Never commit, push, or open a pull request in the working repo (\`$MATE_REPO_PATH\`) unless the user explicitly asks for it.
- Never connect to a database (local or remote), touch live/external systems (deploys, infra), or take destructive/irreversible actions without asking the user first.

<!-- MATE:COMPANION:END -->
"
,
  "claudeSettingsLocal": {
    "autoMemoryEnabled": false,
    "hooks": {
      "PreToolUse": [
        {
          "hooks": [
            {
              "args": [
                "hook-pre-tool-use",
              ],
              "command": "<root>/bin/tokensave",
              "type": "command",
            },
          ],
          "matcher": "Agent|Grep|Bash",
        },
      ],
      "Stop": [
        {
          "hooks": [
            {
              "args": [
                "hook-stop",
              ],
              "command": "<root>/bin/tokensave",
              "type": "command",
            },
          ],
        },
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "args": [
                "hook-prompt-submit",
              ],
              "command": "<root>/bin/tokensave",
              "type": "command",
            },
          ],
        },
      ],
    },
    "permissions": {
      "allow": [
        "Bash(mate:*)",
        "Edit(<root>/companion/**)",
        "Read(<root>/companion/**)",
        "mcp__tokensave__*",
      ],
    },
  },
  "claudeSkills": {},
  "opencodeConfig": null,
  "opencodePlugins": {},
  "opencodeSkills": {},
  "opencodeTui": null,
}
`;

exports[`runtime surface golden fixtures setup tokensave × claude 2`] = `
{
  "claudeArgs": [
    "--add-dir",
    "<root>/companion",
    "--append-system-prompt",
    
"## MANDATORY RULES - NON-NEGOTIABLE

<companion-policy framework="mate" priority="mandatory">
  <overview>You are operating inside the mate companion repository.</overview>
  <context>
    <paths>
      <path role="working-repository" env="MATE_REPO_PATH"><root>/working</path>
      <path role="companion-repository" env="MATE_ARTIFACT_PATH"><root>/companion</path>
      <path role="package-wrapper-bin" env="MATE_WRAPPER_BIN_PATH"><wrapper-bin></path>
    </paths>
    <cli-tools>
      <cli name="openspec" type="wrapper" invokeAs="<wrapper-bin>/openspec" />
      <cli name="graphify" type="wrapper" invokeAs="<wrapper-bin>/graphify" />
      <cli name="mate" type="global" invokeAs="mate" />
    </cli-tools>
    <linked-repository id="app" />
  </context>
  <mandatory-rules>
    <rule id="artifact-location" severity="critical">Agent artifacts MUST go to <root>/companion, NEVER <root>/working. Artifacts include plans, specs, ADRs, todos, notes, handoffs, reasoning docs, and scratch files.</rule>
    <rule id="pre-write-classification" severity="critical">Before ANY write, classify the target as product-code or agent-artifact. If unsure, treat it as agent-artifact.</rule>
    <rule id="product-code-location" severity="critical">Product code (README, docs, source, tests) belongs in <root>/working. Agent-artifacts belong in <root>/companion.</rule>
    <rule id="local-artifact-exception" severity="critical">Only write artifacts in <root>/working when the exact path is gitignored AND intentionally local-only; otherwise use <root>/companion.</rule>
    <rule id="guardrail" severity="critical">Bad artifact writes to <root>/working are rejected. Classify correctly first.</rule>
    <rule id="wrapper-only-cli-execution" severity="critical">For every CLI declared in cli-tools, invoke the exact path in its invokeAs attribute. Correct: <wrapper-bin>/openspec status ... . Incorrect: openspec status ... . Do not run bare openspec or graphify commands and do not rely on PATH, aliases, or shell functions. If the exact wrapper path is unavailable, stop and report it.</rule>
  </mandatory-rules>
</companion-policy>

<codebase-exploration-rules priority="mandatory">
<trigger>Codebase-understanding: architecture, tracing, integrations, impact, "how does X work?"</trigger>
<order>tokensave -> grep/glob/read. MUST try tokensave before raw source.
1. tokensave_context first.
2. Use grep/glob/read only after tokensave is empty or irrelevant.</order>
<post-edit>After code changes, run mate cap index --tokensave.</post-edit>
</codebase-exploration-rules>"
,
    "--setting-sources",
    "user,project,local",
    "--settings",
    "<root>/companion/.claude/settings.local.json",
    "--mcp-config",
    "<root>/companion/.mcp.json",
    "--plugin-dir",
    "<claude-plugin>",
  ],
  "claudeEnv": {
    "CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD": "1",
  },
}
`;

