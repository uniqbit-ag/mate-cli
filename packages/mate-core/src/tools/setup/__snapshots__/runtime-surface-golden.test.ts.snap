<!-- MATE:COMPANION:END -->
"
,
  "claudeHooks": {},
  "claudeMcpConfig": null,
  "claudeMd": null,
  "claudeSettingsLocal": null,
  "claudeSkills": {},
  "opencodeConfig": {
    "$schema": "https://opencode.ai/config.json",
    "compaction": {
      "auto": true,
      "prune": true,
      "reserved": 15000,
    },
    "plugin": [
      "@uniqbit/mate-opencode-plugin@0.15.4-canary.10",
    ],
    "references": {
      "mate": "..",
    },
    "tool_output": {
      "max_bytes": 20000,
      "max_lines": 500,
    },
  },
  "opencodePlugins": {
    "graphify.js": 
"export default {}
"
,
  },
  "opencodeSkills": {
    "graphify/SKILL.md": 
"---
description: builds graphify-out artifacts
---
Write chunks to $GRAPHIFY_OUT and read $GRAPHIFY_OUT later.
"
,
    "graphify/references/github-and-merge.md": 
"Merge graphs into graphify-out of each clone.
"
,
    "graphify/references/usage.md": 
"Outputs land in $GRAPHIFY_OUT by default.
"
,
  },
  "opencodeTui": {
    "$schema": "https://opencode.ai/tui.json",
    "plugin": [
      "@uniqbit/mate-opencode-plugin@0.15.4-canary.10",
    ],
  },
}
`;

