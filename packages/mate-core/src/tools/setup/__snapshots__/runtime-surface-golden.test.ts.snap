<!-- MATE:COMPANION:END -->
"
,
  "claudeHooks": {},
  "claudeMcpConfig": {
    "mcpServers": {},
  },
  "claudeMd": 
"@AGENTS.md
"
,
  "claudeSettingsLocal": {
    "attribution": {
      "commit": "",
      "pr": "",
      "sessionUrl": false,
    },
    "autoMemoryEnabled": false,
    "enableArtifact": false,
    "hooks": {
      "PreToolUse": [
        {
          "hooks": [
            {
              "command": "<root>/companion/.claude/hooks/graphify-guard.sh",
              "type": "command",
            },
          ],
          "matcher": "Bash",
        },
      ],
    },
    "permissions": {
      "allow": [
        "Bash(<wrapper-bin>/graphify:*)",
        "Bash(graphify:*)",
        "Bash(mate cap graphify:*)",
        "Bash(mate:*)",
        "Edit(<root>/companion/**)",
        "Read(<root>/companion/**)",
        "Skill(graphify)",
      ],
      "deny": [
        "EnterPlanMode",
        "DesignSync",
        "Read(**/.env)",
        "Edit(**/.env)",
        "Read(**/.env.local)",
        "Edit(**/.env.local)",
        "Read(**/.env.development)",
        "Edit(**/.env.development)",
        "Read(**/.env.production)",
        "Edit(**/.env.production)",
        "Read(**/.env.test)",
        "Edit(**/.env.test)",
