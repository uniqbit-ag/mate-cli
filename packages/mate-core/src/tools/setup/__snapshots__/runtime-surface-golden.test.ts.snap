"
,
    "openspec-apply-change/SKILL.md": "b023edd228ab",
    "openspec-archive-change/SKILL.md": "890bada99035",
    "openspec-explore/SKILL.md": "477fdec2cdb0",
    "openspec-propose/SKILL.md": "13e8a2d0d873",
    "react-doctor/SKILL.md": "df58b3490543",
    "react-doctor/references/explain.md": "2382ea820f20",
  },
  "opencodeConfig": {
    "$schema": "https://opencode.ai/config.json",
    "compaction": {
      "auto": true,
      "prune": true,
      "reserved": 15000,
    },
    "mcp": {
      "tokensave": {
