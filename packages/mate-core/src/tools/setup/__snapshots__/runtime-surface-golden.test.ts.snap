        "Skill(context-mode:context-mode)",
        "mcp__plugin_context-mode_context-mode__*",
      ],
    },
  },
  "claudeSkills": {},
  "opencodeConfig": null,
  "opencodePlugins": {},
  "opencodeSkills": {},
  "opencodeTui": null,
}
`;

