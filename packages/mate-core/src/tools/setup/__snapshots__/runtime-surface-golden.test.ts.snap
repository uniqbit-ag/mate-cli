    "user,project,local",
    "--settings",
    "<root>/companion/.claude/state/launch-settings.app.json",
    "--plugin-dir",
    "<claude-plugin>",
    "--plugin-dir",
    "<root>/companion/.mate/plugins/.local/node_modules/context-mode",
  ],
  "claudeEnv": {},
  "opencodeArgs": [
    "<root>/working",
    "--standalone",
  ],
  "opencodeEnv": {
    "MATE_GUIDANCE_JSON": {
      "codebaseExplorationGuidance": "",
      "companionGuidance": 
"## MANDATORY RULES - NON-NEGOTIABLE

<companion-policy framework="mate" priority="mandatory">
  <overview>You are operating inside the mate companion repository.</overview>
  <context>
    <paths>
      <path role="companion-repository" env="MATE_ARTIFACT_PATH">$MATE_ARTIFACT_PATH</path>
      <path role="package-wrapper-bin" env="MATE_WRAPPER_BIN_PATH">$MATE_WRAPPER_BIN_PATH</path>
      <path role="working-repository" env="MATE_REPO_PATH">$MATE_REPO_PATH</path>
    </paths>
    <cli-tools>
      <cli name="openspec" type="wrapper" invokeAs="$MATE_WRAPPER_BIN_PATH/openspec" />
      <cli name="graphify" type="wrapper" invokeAs="$MATE_WRAPPER_BIN_PATH/graphify" />
      <cli name="mate" type="global" invokeAs="mate" />
    </cli-tools>
    <linked-repository id="$MATE_REPO_ID" />
  </context>
  <mandatory-rules>
    <rule id="artifact-location" severity="critical">Agent artifacts MUST go to $MATE_ARTIFACT_PATH, NEVER $MATE_REPO_PATH. Artifacts include plans, specs, ADRs, todos, notes, handoffs, reasoning docs, and scratch files.</rule>
    <rule id="pre-write-classification" severity="critical">Before ANY write, classify the target as product-code or agent-artifact. If unsure, treat it as agent-artifact.</rule>
    <rule id="product-code-location" severity="critical">Product code (README, docs, source, tests) belongs in $MATE_REPO_PATH. Agent-artifacts belong in $MATE_ARTIFACT_PATH.</rule>
    <rule id="local-artifact-exception" severity="critical">Only write artifacts in $MATE_REPO_PATH when the exact path is gitignored AND intentionally local-only; otherwise use $MATE_ARTIFACT_PATH.</rule>
    <rule id="guardrail" severity="critical">Bad artifact writes to $MATE_REPO_PATH are rejected. The guardrail resolves relative paths against $MATE_REPO_PATH and does not follow cd, so write artifacts, including shell redirects and tee, with absolute paths under $MATE_ARTIFACT_PATH. Classify correctly first.</rule>
    <rule id="companion-multi-repository" severity="critical">This Companion Repository may serve multiple Working Repositories. The working-repository path above identifies this session's single primary Working Repository, not the companion's full repository set. The Companion Repository is the shared artifact and context plane; the primary Working Repository is the product-code plane.</rule>
    <rule id="repository-area-scope" severity="critical">For domain modeling, identify the canonical Working Repository and its repository-relative Area first. A checkout basename or Area alone is not a repository identity. Shared context applies only when the Companion Repository's CONTEXT-MAP explicitly maps it to the current repository and Area.</rule>
    <rule id="wrapper-only-cli-execution" severity="critical">For every CLI declared in cli-tools, invoke the exact path in its invokeAs attribute. Correct: $MATE_WRAPPER_BIN_PATH/openspec status ... . Incorrect: openspec status ... . Do not run bare openspec or graphify commands and do not rely on PATH, aliases, or shell functions. If the exact wrapper path is unavailable, stop and report it.</rule>
    <rule id="secret-handling" severity="critical">Never read, print, copy, or write secret files (.env, .env.*, keys, certificates, credential files such as .npmrc or .netrc) or secret values. To learn which variables exist, read only the example files (.env.example, .env.sample, .env.template, .env.dist). Refer to a secret by its variable name only. Do not print environment variables that may hold secrets. When a secret must be set or rotated, ask the user to do it instead of writing it yourself. Guarded calls are blocked; the companion's framework.yaml secrets block is the user's switch, not yours.</rule>
  </mandatory-rules>
</companion-policy>"
,
      "errors": [],
      "version": 1,
    },
    "OPENCODE_CONFIG_CONTENT": {},
  },
}
`;

