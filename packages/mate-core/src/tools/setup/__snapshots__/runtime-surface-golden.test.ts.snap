exports[`runtime surface golden fixtures setup graphify × claude 1`] = `
{
  "agentsMd": 
"<!-- MATE:COMPANION:START -->

- When reporting information to me, be extremely concise and sacrifice grammar for the sake of concision. Apply this same preference to comments and JSDoc, not implementation code; retain necessary contract details.
- Code comments: sparse and concise — explain non-obvious intent, constraints, or workarounds; avoid filler, restating code, or artifact rationale. Use JSDoc for JS/TS API documentation; line or ordinary block comments for local implementation notes, including JSX-supported expression comments. Preserve required documentation, tool directives, legal notices, generated files, and language-appropriate syntax. Do not rewrite unchanged comments or unrelated code for this preference.
- Never add a \`Co-Authored-By: <model>\` trailer or model-attribution footer to commit messages.
- Never commit, push, or open a pull request in the working repo (\`$MATE_REPO_PATH\`) unless the user explicitly asks for it.
- Never connect to a database (local or remote), touch live/external systems (deploys, infra), or take destructive/irreversible actions without asking the user first.

<!-- MATE:COMPANION:END -->
"
,
  "claudeHooks": {},
  "claudeMcpConfig": {
    "mcpServers": {},
  },
  "claudeMd": 
"@AGENTS.md
"
,
  "claudeSettingsLocal": {
    "attribution": {
      "commit": "",
      "pr": "",
      "sessionUrl": false,
    },
    "autoMemoryEnabled": false,
    "enableArtifact": false,
    "hooks": {
      "PreToolUse": [
        {
          "hooks": [
            {
              "command": "<root>/companion/.claude/hooks/graphify-guard.sh",
              "type": "command",
            },
          ],
          "matcher": "Bash",
        },
      ],
    },
    "permissions": {
      "allow": [
        "Bash(<wrapper-bin>/graphify:*)",
        "Bash(graphify:*)",
        "Bash(mate cap graphify:*)",
        "Bash(mate:*)",
        "Edit(<root>/companion/**)",
        "Read(<root>/companion/**)",
        "Skill(graphify)",
      ],
      "deny": [
        "EnterPlanMode",
        "DesignSync",
        "Read(**/.env)",
        "Edit(**/.env)",
        "Read(**/.env.local)",
        "Edit(**/.env.local)",
        "Read(**/.env.development)",
        "Edit(**/.env.development)",
        "Read(**/.env.production)",
        "Edit(**/.env.production)",
        "Read(**/.env.test)",
        "Edit(**/.env.test)",
        "Read(**/.env.*.local)",
        "Edit(**/.env.*.local)",
        "Read(**/*.pem)",
        "Edit(**/*.pem)",
        "Read(**/*.key)",
        "Edit(**/*.key)",
        "Read(**/*.p12)",
        "Edit(**/*.p12)",
        "Read(**/*.pfx)",
        "Edit(**/*.pfx)",
        "Read(**/id_rsa)",
        "Edit(**/id_rsa)",
        "Read(**/id_ecdsa)",
        "Edit(**/id_ecdsa)",
        "Read(**/id_ed25519)",
        "Edit(**/id_ed25519)",
        "Read(**/.netrc)",
        "Edit(**/.netrc)",
        "Read(**/.pgpass)",
        "Edit(**/.pgpass)",
        "Read(**/.npmrc)",
        "Edit(**/.npmrc)",
      ],
    },
  },
  "claudeSkills": {
    "graphify/SKILL.md": 
"---
description: builds graphify-out artifacts
---
Write chunks to $GRAPHIFY_OUT and read $GRAPHIFY_OUT later.
"
,
    "graphify/references/github-and-merge.md": 
"Merge graphs into graphify-out of each clone.
"
,
    "graphify/references/usage.md": 
"Outputs land in $GRAPHIFY_OUT by default.
"
,
  },
  "opencodeConfig": null,
  "opencodePlugins": {},
  "opencodeSkills": {},
  "opencodeTui": null,
  "sharedSkills": {},
}
`;

exports[`runtime surface golden fixtures setup graphify × claude 2`] = `
{
  "claudeArgs": [
    "--append-system-prompt",
    
"## MANDATORY RULES - NON-NEGOTIABLE

<companion-policy framework="mate" priority="mandatory">
  <overview>You are operating inside the mate companion repository.</overview>
  <context>
    <paths>
      <path role="companion-repository" env="MATE_ARTIFACT_PATH"><root>/companion</path>
      <path role="package-wrapper-bin" env="MATE_WRAPPER_BIN_PATH"><wrapper-bin></path>
      <path role="working-repository" env="MATE_REPO_PATH"><root>/working</path>
    </paths>
    <cli-tools>
      <cli name="openspec" type="wrapper" invokeAs="<wrapper-bin>/openspec" />
      <cli name="graphify" type="wrapper" invokeAs="<wrapper-bin>/graphify" />
      <cli name="mate" type="global" invokeAs="mate" />
    </cli-tools>
    <linked-repository id="app" />
  </context>
  <mandatory-rules>
    <rule id="artifact-location" severity="critical">Agent artifacts MUST go to <root>/companion, NEVER <root>/working. Artifacts include plans, specs, ADRs, todos, notes, handoffs, reasoning docs, and scratch files.</rule>
    <rule id="pre-write-classification" severity="critical">Before ANY write, classify the target as product-code or agent-artifact. If unsure, treat it as agent-artifact.</rule>
    <rule id="product-code-location" severity="critical">Product code (README, docs, source, tests) belongs in <root>/working. Agent-artifacts belong in <root>/companion.</rule>
    <rule id="local-artifact-exception" severity="critical">Only write artifacts in <root>/working when the exact path is gitignored AND intentionally local-only; otherwise use <root>/companion.</rule>
    <rule id="guardrail" severity="critical">Bad artifact writes to <root>/working are rejected. The guardrail resolves relative paths against <root>/working and does not follow cd, so write artifacts, including shell redirects and tee, with absolute paths under <root>/companion. Classify correctly first.</rule>
    <rule id="companion-multi-repository" severity="critical">This Companion Repository may serve multiple Working Repositories. The working-repository path above identifies this session's single primary Working Repository, not the companion's full repository set. The Companion Repository is the shared artifact and context plane; the primary Working Repository is the product-code plane.</rule>
    <rule id="repository-area-scope" severity="critical">For domain modeling, identify the canonical Working Repository and its repository-relative Area first. A checkout basename or Area alone is not a repository identity. Shared context applies only when the Companion Repository's CONTEXT-MAP explicitly maps it to the current repository and Area.</rule>
    <rule id="wrapper-only-cli-execution" severity="critical">For every CLI declared in cli-tools, invoke the exact path in its invokeAs attribute. Correct: <wrapper-bin>/openspec status ... . Incorrect: openspec status ... . Do not run bare openspec or graphify commands and do not rely on PATH, aliases, or shell functions. If the exact wrapper path is unavailable, stop and report it.</rule>
    <rule id="secret-handling" severity="critical">Never read, print, copy, or write secret files (.env, .env.*, keys, certificates, credential files such as .npmrc or .netrc) or secret values. To learn which variables exist, read only the example files (.env.example, .env.sample, .env.template, .env.dist). Refer to a secret by its variable name only. Do not print environment variables that may hold secrets. When a secret must be set or rotated, ask the user to do it instead of writing it yourself. Guarded calls are blocked; the companion's framework.yaml secrets block is the user's switch, not yours.</rule>
  </mandatory-rules>
</companion-policy>

<codebase-exploration-rules priority="mandatory">
<path role="graphify-out">$MATE_ARTIFACT_PATH/.graphify/$MATE_REPO_ID/graphify-out/</path>
<trigger>Codebase-understanding: architecture, tracing, integrations, impact, "how does X work?"</trigger>
<order>graphify -> grep/glob/read. MUST try graphify before raw source.
1. graphify query "<question>" first.
2. Use graphify path "<A>" "<B>" or graphify explain "<concept>" to deepen.
3. Use grep/glob/read only after graphify was tried.</order>
<notes>Dirty graph files are expected. Use wiki/index.md for broad navigation; GRAPH_REPORT.md only if query/path/explain fall short.</notes>
<post-edit>After code changes, run mate cap index --graphify.</post-edit>
</codebase-exploration-rules>"
,
    "--setting-sources",
    "user,project,local",
    "--settings",
    "<root>/companion/.claude/state/launch-settings.app.json",
    "--plugin-dir",
    "<claude-plugin>",
  ],
  "claudeEnv": {},
}
`;

