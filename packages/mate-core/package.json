{
  "name": "@uniqbit/mate-core",
  "version": "1.0.0-canary.2",
  "description": "Core framework and plugin APIs for Mate.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniqbit-ag/mate-cli.git",
    "directory": "packages/mate-core"
  },
  "files": [
    "src/",
    "studio-dist/",
    "wrappers/",
    "claude-plugin/",
    "opencode-plugin/",
    "claude-capability-plugins/",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!opencode-plugin/**/*.test.ts",
    "!claude-capability-plugins/*/tests/",
    "!claude-capability-plugins/*/tsconfig.json",
    "!claude-capability-plugins/*/.claude-plugin/types/"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./plugins": "./src/plugins.ts",
    "./runtime": "./src/runtime/index.ts",
    "./opencode": "./src/opencode/index.ts",
    "./opencode/tui": "./src/opencode/tui.tsx",
    "./tui": "./src/tui.ts",
    "./brand": "./src/brand/index.ts",
    "./studio": "./src/studio.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "bun ../../scripts/studio-app/pack.ts",
    "test": "CI=1 bun ../../test/run-isolated.ts --path-ignore-patterns='claude-capability-plugins/*/tests/{autocomplete,companion-root,mention}.test.ts'",
    "test:unit": "CI=1 bun ../../test/run-isolated.ts --suite=unit --path-ignore-patterns='claude-capability-plugins/*/tests/{autocomplete,companion-root,mention}.test.ts'",
    "test:hooks": "claude plugin validate --strict claude-capability-plugins/companion-mentions && claude plugin test claude-capability-plugins/companion-mentions",
    "test:integration": "CI=1 bun ../../test/run-isolated.ts --suite=integration",
    "typecheck": "bunx tsc --noEmit -p ../../tsconfig.json",
    "lint": "oxlint src/ opencode-plugin/ claude-capability-plugins/*/hooks/",
    "lint:fix": "oxlint src/ opencode-plugin/ claude-capability-plugins/*/hooks/ --fix",
    "format": "oxfmt src/ opencode-plugin/ claude-capability-plugins/ \"!**/*.generated.*\"",
    "format:check": "oxfmt src/ opencode-plugin/ claude-capability-plugins/ \"!**/*.generated.*\" --check"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.167",
    "@ai-sdk/harness-claude-code": "1.0.171",
    "@fission-ai/openspec": "1.15.0",
    "@opencode/plugin": "^2.0.23",
    "@secretlint/core": "13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "@secretlint/types": "13.0.7",
    "@tanstack/highlight": "0.0.10",
    "@wterm/core": "0.5.7",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "7.0.156",
    "ink": "^7.1.0",
    "jsonc-parser": "^3.3.1",
    "marked": "^18.1.1",
    "react": "^19.2.7",
    "react-doctor": "0.9.13",
    "semver": "^7.8.5",
    "yaml": "^2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opentui/core": "^0.5.14",
    "@opentui/keymap": "^0.5.14",
    "@opentui/solid": "^0.5.14",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/semver": "^7.7.1"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.14",
    "@opentui/keymap": ">=0.5.14",
    "@opentui/solid": ">=0.5.14"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/keymap": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "bun@1.4.4"
}
