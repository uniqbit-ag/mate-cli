{
  "name": "@uniqbit/mate-core",
  "version": "0.18.1-canary.5",
  "description": "Core framework and plugin APIs for Mate.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniqbit-ag/mate-cli.git",
    "directory": "packages/mate-core"
  },
  "files": [
    "src/",
    "wrappers/",
    "claude-plugin/",
    "opencode-plugin/",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!opencode-plugin/**/*.test.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./plugins": "./src/plugins.ts",
    "./runtime": "./src/runtime/index.ts",
    "./opencode": "./src/opencode/index.ts",
    "./opencode/tui": "./src/opencode/tui.tsx",
    "./tui": "./src/tui.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "CI=1 bun ../../test/run-isolated.ts",
    "typecheck": "bunx tsc --noEmit -p ../../tsconfig.json",
    "lint": "oxlint src/ opencode-plugin/",
    "lint:fix": "oxlint src/ opencode-plugin/ --fix",
    "format": "oxfmt src/ opencode-plugin/ \"!**/*.generated.*\" \"!**/report-assets/**\"",
    "format:check": "oxfmt src/ opencode-plugin/ \"!**/*.generated.*\" \"!**/report-assets/**\" --check"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.23",
    "@opentui/core": "^0.5.14",
    "@opentui/keymap": "^0.5.14",
    "@opentui/solid": "^0.5.14",
    "@tanstack/highlight": "0.0.10",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "hono": "^4.13.5",
    "ink": "^7.1.0",
    "react": "^19.2.7",
    "react-doctor": "0.9.13",
    "semver": "^7.8.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/semver": "^7.7.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
