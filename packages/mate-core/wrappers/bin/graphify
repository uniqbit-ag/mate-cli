#!/usr/bin/env bash
_this_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Mate context: the launch environment first, the Working Repository's
# Projection Root second. Projected values stay in private shell variables and
# no MATE_-prefixed variable is exported: the projection carries paths and
# never predicates, so a partial MATE_* environment would read to any child as
# authoritative with every predicate disabled.
_mate_projection_file() {
  local dir="$PWD"
  while :; do
    if [ -f "$dir/.mate/config/registry.yaml" ]; then
      [ -f "$dir/.mate/projection.env" ] && printf '%s' "$dir/.mate/projection.env"
      return
    fi
    [ "$dir" = "/" ] && return
    dir="$(dirname "$dir")"
  done
}

_mate_projected() {
  sed -n "s/^$2='\\(.*\\)'\$/\\1/p" "$1" | head -n 1 | sed "s/'\\\\''/'/g"
}

_mate_same_dir() {
  local left="$1" right="$2"
  [ -d "$left" ] && left="$(cd "$left" && pwd)"
  [ -d "$right" ] && right="$(cd "$right" && pwd)"
  [ "$left" = "$right" ]
}

_companion="$MATE_ARTIFACT_PATH"
_repo_path="$MATE_REPO_PATH"
_graphify_out="$GRAPHIFY_OUT"
if [ -z "$_companion" ]; then
  _projection="$(_mate_projection_file)"
  if [ -n "$_projection" ]; then
    _companion="$(_mate_projected "$_projection" MATE_ARTIFACT_PATH)"
    _repo_path="$(_mate_projected "$_projection" MATE_REPO_PATH)"
    _graphify_out="$(_mate_projected "$_projection" GRAPHIFY_OUT)"
    _projected_wrapper_dir="$(_mate_projected "$_projection" MATE_WRAPPER_BIN_PATH)"
    if [ -n "$_companion" ] && ! _mate_same_dir "$_projected_wrapper_dir" "$_this_dir"; then
      {
        echo "graphify: this repository was wrapped by a different mate install."
        echo "  projected wrappers: $_projected_wrapper_dir"
        echo "  running wrapper:    $_this_dir"
        echo "  re-run \`mate wrap\` with this install."
      } >&2
      exit 1
    fi
  fi
fi
[ -n "$_companion" ] || { echo "graphify: no mate context here — run \`mate wrap\` in this repository" >&2; exit 1; }
[ -n "$_repo_path" ] || { echo "graphify: no working repository in the mate context — run \`mate wrap\` in this repository" >&2; exit 1; }
[ -n "$_graphify_out" ] || { echo "graphify: no graphify output path in the mate context — run \`mate wrap\` in this repository" >&2; exit 1; }

_real=""
IFS=:
for _dir in $PATH; do
    [ "$_dir" = "$_this_dir" ] && continue
    [ -x "$_dir/graphify" ] || continue
    _real="$_dir/graphify"
    break
done
unset IFS
[ -n "$_real" ] || { echo "graphify wrapper: real graphify binary not found in PATH" >&2; exit 1; }

_graphify_root="$(dirname "$_graphify_out")"
_graph_json="$_graphify_out/graph.json"
export GRAPHIFY_OUT="$_graphify_out"

# Secret gate: leaves secret files out of every extraction and prunes any
# secret that still reaches the output. It never stops graphify: when the gate
# can't run, the wrapper warns and runs graphify anyway.
_gate="$_this_dir/../lib/graphify-gate.mjs"
_secret_excludes=()
_secret_pre() {
  local _out _p
  if ! _out="$(node "$_gate" pre "$_companion" "$_repo_path")"; then
    echo "graphify: warning: the secret gate did not run; secret files may be indexed" >&2
    return
  fi
  while IFS= read -r _p; do
    [ -n "$_p" ] && _secret_excludes+=(--exclude "$_p")
  done <<< "$_out"
}
_secret_post() {
  node "$_gate" post "$_companion" "$_graphify_out" ||
    echo "graphify: warning: the graphify output was not checked for secrets" >&2
}
# Runs an extraction that accepts --exclude, then prunes its output.
_extract() {
  _secret_pre
  "$_real" "$@" "${_secret_excludes[@]}"
  local _status=$?
  _secret_post
  exit "$_status"
}

_cmd="${1:-}"
case "$_cmd" in
  build)
    mkdir -p "$_graphify_out"
    _rest=()
    for _a in "${@:2}"; do
      case "$_a" in
        --output) _rest+=(--out) ;;
        --output=*) _rest+=("--out=${_a#--output=}") ;;
        *) _rest+=("$_a") ;;
      esac
    done
    _extract extract "$_repo_path" --out "$_graphify_root" "${_rest[@]}"
    ;;
  update)
    if [ "$#" -eq 1 ] || [[ "$2" == -* ]]; then
      _extract "$_repo_path" --update "${@:2}"
    else
      _extract "$2" --update "${@:3}"
    fi
    ;;
  extract)
    if [ "$#" -eq 1 ] || [[ "$2" == -* ]]; then
      _extract extract "$_repo_path" "${@:2}"
    else
      _extract "$@"
    fi
    ;;
  watch)
    # Long-running: only the ignore region applies; there is no output to prune.
    _secret_pre
    if [ "$#" -eq 1 ] || [[ "$2" == -* ]]; then
      exec "$_real" watch "$_repo_path" "${@:2}"
    else
      exec "$_real" "$@"
    fi
    ;;
  cluster-only|label|check-update)
    if [ "$#" -eq 1 ] || [[ "$2" == -* ]]; then
      exec "$_real" "$_cmd" "$_repo_path" "${@:2}"
    else
      exec "$_real" "$@"
    fi
    ;;
  query|path|explain|affected|tree)
    _has_graph=false
    for _a in "$@"; do
      case "$_a" in --graph|-g|--graph=*) _has_graph=true; break;; esac
    done
    if "$_has_graph"; then
      exec "$_real" "$@"
    else
      exec "$_real" "$@" --graph "$_graph_json"
    fi
    ;;
  lookup)
    _has_graph=false
    for _a in "${@:2}"; do
      case "$_a" in --graph|-g|--graph=*) _has_graph=true; break;; esac
    done
    if "$_has_graph"; then
      exec "$_real" query "${@:2}"
    else
      exec "$_real" query "${@:2}" --graph "$_graph_json"
    fi
    ;;
  *)
    # A direct `graphify <path> --update` is an extraction too.
    for _a in "$@"; do
      [ "$_a" = "--update" ] && _extract "$@"
    done
    exec "$_real" "$@"
    ;;
esac
