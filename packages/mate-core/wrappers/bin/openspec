#!/usr/bin/env bash
_this_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Mate context: the launch environment first, the Working Repository's
# Projection Root second. Projected values stay in private shell variables and
# no MATE_-prefixed variable is exported: the projection carries paths and
# never predicates, so a partial MATE_* environment would read to any child as
# authoritative with every predicate disabled.
_mate_projection_file() {
  local dir="$PWD"
  while :; do
    if [ -f "$dir/.mate/config/registry.yaml" ]; then
      [ -f "$dir/.mate/projection.env" ] && printf '%s' "$dir/.mate/projection.env"
      return
    fi
    [ "$dir" = "/" ] && return
    dir="$(dirname "$dir")"
  done
}

_mate_projected() {
  sed -n "s/^$2='\\(.*\\)'\$/\\1/p" "$1" | head -n 1 | sed "s/'\\\\''/'/g"
}

_mate_same_dir() {
  local left="$1" right="$2"
  [ -d "$left" ] && left="$(cd "$left" && pwd)"
  [ -d "$right" ] && right="$(cd "$right" && pwd)"
  [ "$left" = "$right" ]
}

_companion="$MATE_ARTIFACT_PATH"
_repo="$MATE_REPO_PATH"
if [ -z "$_companion" ]; then
  _projection="$(_mate_projection_file)"
  if [ -n "$_projection" ]; then
    _companion="$(_mate_projected "$_projection" MATE_ARTIFACT_PATH)"
    _repo="$(_mate_projected "$_projection" MATE_REPO_PATH)"
    _projected_wrapper_dir="$(_mate_projected "$_projection" MATE_WRAPPER_BIN_PATH)"
    if [ -n "$_companion" ] && ! _mate_same_dir "$_projected_wrapper_dir" "$_this_dir"; then
      {
        echo "openspec: this repository was wrapped by a different mate install."
        echo "  projected wrappers: $_projected_wrapper_dir"
        echo "  running wrapper:    $_this_dir"
        echo "  re-run \`mate wrap\` with this install."
      } >&2
      exit 1
    fi
  fi
fi
[ -n "$_companion" ] || { echo "openspec: no mate context here — run \`mate wrap\` in this repository" >&2; exit 1; }

# The OpenSpec CLI Mate ships with, found the way Node resolves it: upward from
# the package root, hoisted or nested under mate-core (distribution packages).
# Never an openspec on PATH, so a global install of another version is ignored.
# Physical path: the runtime directory reaches wrappers/ through a symlink.
_real=""
_dir="$(cd -P "$_this_dir" && cd ../.. && pwd -P)"
while [ -z "$_real" ]; do
  for _candidate in \
    "$_dir/node_modules/@fission-ai/openspec/bin/openspec.js" \
    "$_dir/node_modules/@uniqbit/mate-core/node_modules/@fission-ai/openspec/bin/openspec.js"; do
    if [ -f "$_candidate" ]; then
      _real="$_candidate"
      break 2
    fi
  done
  [ "$_dir" = "/" ] && break
  _dir="$(dirname "$_dir")"
done
[ -n "$_real" ] || { echo "openspec: bundled OpenSpec CLI is missing. Reinstall Mate to restore it." >&2; exit 1; }
command="${1-}"
if [ "$command" = "templates" ]; then
  has_schema=0
  for arg in "$@"; do
    if [ "$arg" = "--schema" ]; then
      has_schema=1
      break
    fi
  done
  if [ "$has_schema" -eq 0 ]; then
    _schema=""
    for _cfg in "$_companion/openspec/config.yaml" "$_companion/openspec/config.yml"; do
      [ -f "$_cfg" ] || continue
      while IFS= read -r _line; do
        case "$_line" in
          schema:*)
            _schema="${_line#schema:}"
            _schema="${_schema#"${_schema%%[![:space:]]*}"}"
            _schema="${_schema%"${_schema##*[![:space:]]}"}"
            case "$_schema" in
              "*") _schema="${_schema#\"}"; _schema="${_schema%\"}" ;;
              "'*'") _schema="${_schema#'}"; _schema="${_schema%'}" ;;
            esac
            [ -n "$_schema" ] && break
            ;;
        esac
      done < "$_cfg"
      [ -n "$_schema" ] && break
    done
    if [ -n "$_schema" ]; then
      set -- "$command" "--schema" "$_schema" "${@:2}"
    fi
  fi
fi

_mate_is_under() {
  case "$1/" in "$2"/*) return 0 ;; esac
  return 1
}

# Moves _cwd to the Working Repository root when the caller is inside that
# repository, outside the companion, and the root carries Mate's pointer.
_mate_use_store_pointer() {
  [ -n "$_repo" ] && [ -d "$_repo" ] || return 0
  local repo_root here companion_root pointer first
  repo_root="$(cd "$_repo" && pwd -P)"
  here="$(pwd -P)"
  companion_root="$(cd "$_companion" 2>/dev/null && pwd -P)"
  _mate_is_under "$here" "$repo_root" || return 0
  [ -n "$companion_root" ] && _mate_is_under "$here" "$companion_root" && return 0
  pointer="$repo_root/openspec/config.yaml"
  if [ -f "$pointer" ]; then
    IFS= read -r first < "$pointer" || true
    case "$first" in
      "# generated by "*" — do not edit") _cwd="$repo_root" ;;
    esac
  elif [ ! -f "$repo_root/openspec/config.yml" ]; then
    echo "openspec: no OpenSpec store pointer in $repo_root, so edits are scoped to the companion — run \`mate wrap\` to enable Working Repository edit roots" >&2
  fi
}

# Commands that resolve an OpenSpec root run from the Working Repository root
# when it carries Mate's store pointer: OpenSpec then plans in the companion's
# store and names the repository as the edit root. The root, not the caller's
# cwd, so a nested openspec/ cannot win. Every other case — including
# templates, init and update, which do not resolve stores — stays on the
# companion, exactly as before.
_cwd="$_companion"
case "$command" in
  new|status|instructions|list|show|validate|archive|doctor|context|schemas|view)
    _mate_use_store_pointer
    ;;
esac
# A JS entry's `#!/usr/bin/env node` shebang needs an executable bit and `node`
# on PATH; without either (Bun-only installs) it runs on an explicit runtime.
_shebang=""
[ "${_real%.js}" != "$_real" ] && { IFS= read -r _shebang < "$_real" || true; }
if [ -n "$_shebang" ] && {
  [ ! -x "$_real" ] ||
    { [ "$_shebang" = "#!/usr/bin/env node" ] && ! command -v node >/dev/null 2>&1; }
}; then
  _runtime="$(command -v node || command -v bun || true)"
  [ -n "$_runtime" ] || { echo "openspec: neither node nor bun is on PATH to run $_real" >&2; exit 1; }
  set -- "$_real" "$@"
  _real="$_runtime"
fi
# Mate decides the OpenSpec version, so OpenSpec's update hint is wrong advice
# here; both variables reach the delegated binary only.
exec env -C "$_cwd" OPENSPEC_TELEMETRY=0 OPENSPEC_NO_UPDATE_CHECK=1 "$_real" "$@"
