---
import { ClientRouter } from "astro:transitions";
import { withBase } from "@/lib/base";
import { BRAND } from "@/lib/brand.generated";

interface Props {
  title?: string;
  description?: string;
  /** Pages sharing a name keep their persisted body across client navigation. */
  transitionName?: string;
}

const {
  title = "Mate Docs",
  description = "Companion-first docs for Mate: setup, launch flow, concepts, capabilities, and CLI reference.",
  transitionName = "page-layout",
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase("/og.png"), Astro.site).href;
/** The brand palette as custom properties; `styles/global.css` maps theme roles onto them. */
const brandVariables = `:root {
  --mate-ink: ${BRAND.ink};
  --mate-green: ${BRAND.mateGreen};
  --mate-cream: ${BRAND.cream};
  --mate-light-green: ${BRAND.lightGreen};
  --mate-night: ${BRAND.night};
}`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase("/brand/favicon.ico")} sizes="any" />
    <link rel="icon" href={withBase("/brand/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase("/brand/apple-touch-icon.png")} />
    <meta name="theme-color" content={BRAND.ink} />
    <style is:inline set:html={brandVariables} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mate" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <ClientRouter />
    <script is:inline>
      /**
       * Client navigation replaces <html> attributes with the new page's server
       * HTML, which has no theme class yet. Carry the active theme over so dark
       * mode does not flash light while the theme script catches up.
       */
      if (!window.__mateThemeSwap) {
        window.__mateThemeSwap = true;
        document.addEventListener("astro:before-swap", (event) => {
          const current = document.documentElement;
          const next = event.newDocument.documentElement;
          next.className = current.className;
          next.style.colorScheme = current.style.colorScheme;
        });
      }
    </script>
  </head>
  <body
    class="relative isolate flex min-h-screen flex-col bg-fd-background text-fd-foreground"
    transition:persist
    transition:animate="none"
    transition:name={transitionName}
  >
    <slot />
  </body>
</html>
