---
import { LaunchPipeline } from "@/components/diagrams";
import { steps } from "@/content/landing";
import SectionHeading from "./SectionHeading.astro";
---

<section class="border-y bg-fd-card/40">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <SectionHeading
      eyebrow="How it works"
      title="Install, link, launch"
      description="Three commands from your working repository. After that, every launch prepares the agent the same way."
    />
    <ol class="grid gap-4 md:grid-cols-3">
      {
        steps.map((step, index) => (
          <li class="rounded-xl border bg-fd-background p-5">
            <div class="flex items-center gap-3">
              <span class="flex size-7 items-center justify-center rounded-full bg-fd-primary text-sm font-semibold text-fd-primary-foreground">
                {index + 1}
              </span>
              <h3 class="text-lg font-semibold">{step.title}</h3>
            </div>
            <code class="mt-4 block rounded-md bg-fd-muted px-3 py-2 font-mono text-sm">{step.command}</code>
            <p class="mt-3 text-sm text-fd-muted-foreground">{step.description}</p>
          </li>
        ))
      }
    </ol>
    <div class="mt-10">
      <LaunchPipeline />
    </div>
  </div>
</section>
