{
  "name": "@uniqbit/mate-vscode",
  "displayName": "Mate",
  "version": "1.0.0-canary.0",
  "description": "Mate sidebar for VS Code and Cursor: park and resume sessions, worktrees, open changes, and changes ready to publish. Install with `mate vscode setup`.",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniqbit-ag/mate-cli.git",
    "directory": "apps/mate-vscode"
  },
  "publisher": "uniqbit",
  "files": [
    "mate-vscode.vsix"
  ],
  "type": "module",
  "main": "./dist/extension.cjs",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.ts",
    "prepack": "bun scripts/package-vsix.ts",
    "test": "CI=1 bun ../../test/run-isolated.ts",
    "test:unit": "CI=1 bun ../../test/run-isolated.ts --suite=unit",
    "test:integration": "CI=1 bun ../../test/run-isolated.ts --suite=integration",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "lint": "oxlint src/ scripts/",
    "lint:fix": "oxlint src/ scripts/ --fix",
    "format": "oxfmt src/ scripts/",
    "format:check": "oxfmt src/ scripts/ --check"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^4.1.0",
    "tsdown": "0.23.0",
    "typescript": "latest"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mate",
          "title": "Mate",
          "icon": "media/mate.svg"
        }
      ]
    },
    "views": {
      "mate": [
        {
          "id": "mate.sessions",
          "name": "Sessions"
        },
        {
          "id": "mate.worktrees",
          "name": "Worktrees"
        },
        {
          "id": "mate.openChanges",
          "name": "Open changes"
        },
        {
          "id": "mate.readyToPublish",
          "name": "Ready to publish"
        }
      ]
    },
    "commands": [
      {
        "command": "mate.newSession",
        "title": "New session",
        "category": "Mate",
        "icon": "$(add)"
      },
      {
        "command": "mate.refresh",
        "title": "Refresh",
        "category": "Mate",
        "icon": "$(refresh)"
      },
      {
        "command": "mate.resumeSession",
        "title": "Resume",
        "category": "Mate",
        "icon": "$(play)"
      },
      {
        "command": "mate.parkSession",
        "title": "Park",
        "category": "Mate",
        "icon": "$(debug-pause)"
      },
      {
        "command": "mate.removeSession",
        "title": "Remove",
        "category": "Mate",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "mate.newSession",
          "when": "view == mate.sessions",
          "group": "navigation@1"
        },
        {
          "command": "mate.refresh",
          "when": "view =~ /^mate\\./",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "mate.resumeSession",
          "when": "view == mate.sessions && viewItem =~ /^session\\./",
          "group": "inline@1"
        },
        {
          "command": "mate.parkSession",
          "when": "view == mate.sessions && viewItem == session.running",
          "group": "inline@2"
        },
        {
          "command": "mate.removeSession",
          "when": "view == mate.sessions && viewItem =~ /^session\\./",
          "group": "inline@3"
        }
      ],
      "commandPalette": [
        {
          "command": "mate.resumeSession",
          "when": "false"
        },
        {
          "command": "mate.parkSession",
          "when": "false"
        },
        {
          "command": "mate.removeSession",
          "when": "false"
        }
      ]
    }
  },
  "activationEvents": [],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  }
}
